# ============================================================
# Binance Auto Rebalance Bot — .env example
# ------------------------------------------------------------
# Copy this file to .env and fill in your values.
# .env is gitignored (see .gitignore) — never commit real keys.
# ============================================================

# ---------- Binance API credentials (REQUIRED) ----------
# Create keys at: https://www.binance.com/en/my/settings/api-management
# For paper trading use testnet keys: https://testnet.binance.vision/
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Docker-only: compose.yml reads this to route paper/live profiles.
# The Python code picks testnet automatically from --mode (paper = testnet).
BINANCE_TESTNET=true

# ---------- Trading defaults ----------
# These are read from config/global_config.json today; the vars below
# are reserved for future override support.
TOTAL_CAPITAL_USDT=10000
MAX_ALLOCATION_PER_COIN=0.20

# ---------- Risk management ----------
STOP_LOSS_PERCENT=25
MAX_CONCURRENT_STRATEGIES=5

# ---------- Logging ----------
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log

# ---------- Backtest date range ----------
# Override via CLI: --days N  OR  --start YYYY-MM-DD --end YYYY-MM-DD
BACKTEST_START_DATE=2024-01-01
BACKTEST_END_DATE=2024-12-31

# ---------- Docker ports ----------
DASHBOARD_PORT=5000
DEMO_PORT=5001

# ============================================================
# Distribution Order Mode (new)
# ------------------------------------------------------------
# Distribution is enabled per-strategy in config/strategies/*.json
# under the "order_placement" block — NOT via env vars. See README
# section "Distribution Order Mode" for the full config schema.
# No additional env vars are required for distribution mode.
# ============================================================
